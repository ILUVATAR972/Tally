{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Utiliser la caméra comme moniteur avec voyant tally",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      "@react-native-vector-icons/material-design-icons",
      "@react-native-vector-icons/ionicons"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.multicamtallyapp.q1mkbc",
      "infoPlist": {
        "NSCameraUsageDescription": "Utiliser la caméra comme moniteur tally",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.multicamtallyapp.q1mkbc",
      "permissions": ["CAMERA", "VIBRATE"]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
